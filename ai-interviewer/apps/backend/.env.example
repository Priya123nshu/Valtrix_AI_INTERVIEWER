# Server Configuration
PORT=3001

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/interviewer_db?schema=public"

# OpenAI API Key (Realtime & Evaluation)
OPENAI_API_KEY=your_openai_api_key_here

# AI Models (Optional overrides)
REALTIME_MODEL=gpt-4o-realtime-preview
RESUME_EXTRACTION_MODEL=gpt-4o
EVALUATION_MODEL=gpt-4o

# Scrapers & Intel (Optional)
GITHUB_TOKEN=
CONTEXT_DEV_API_KEY=
